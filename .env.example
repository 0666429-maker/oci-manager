# ===== OCI 认证（二选一，推荐第 1 种）=====
# 1) 直接用环境变量（不要提交到 Git）
OCI_USER_OCID=ocid1.user.oc1..xxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=/home/user/.oci/oci_api_key.pem
OCI_REGION=ap-singapore-1
# 可选：默认 compartment，不填则调用时必须传 compartment_id
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxx

# 2) 用标准 OCI config 文件（~/.oci/config），此时上面 5 项可留空，
#    但仍建议显式设置 OCI_REGION / OCI_COMPARTMENT_OCID
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# ===== Web 面板 =====
APP_HOST=0.0.0.0
APP_PORT=9527
# 面板登录账号（务必改掉默认值；留空 = 不设密码，仅限内网/可信网络使用）
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me-please
# JWT/会话密钥，部署前务必换成随机长串
APP_SECRET=change-me-to-a-long-random-string

# ===== Telegram Bot（可选，不填则不启动 Bot）=====
TELEGRAM_BOT_TOKEN=
# 允许使用 Bot 的 Telegram user id，逗号分隔；留空 = 不限制（不推荐）
TELEGRAM_ALLOWED_USERS=

# ===== 监控告警（可选）=====
# 流量/状态检查间隔（秒）
MONITOR_INTERVAL_SECONDS=300
# 告警推送到 Telegram 时复用上面的 Bot Token 和用户 id
